---
import { APP_STORE_URL, PLAY_STORE_URL, STRINGS } from '../i18n/locales.js';

const { locale = 'en' } = Astro.props;
const t = STRINGS[locale];
const copy = t.how.steps[2];
const shotPath = `/shots/${locale}/report.webp`;
---

<section class="guide-app-promo" data-guide-app-promo aria-labelledby="guide-app-promo-title">
  <div class="guide-app-visual">
    <div class="guide-app-glow" aria-hidden="true"></div>
    <img
      src={shotPath}
      width="414"
      height="900"
      decoding="async"
      alt={copy.title}
    />
  </div>
  <div class="guide-app-copy">
    <span class="eyebrow">RxDown app</span>
    <h2 id="guide-app-promo-title">{copy.title}</h2>
    <p>{copy.body}</p>
    <div class="guide-app-stores">
      <a class="guide-store-button" href={APP_STORE_URL} rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M17.1 12.5c0-2.4 2-3.6 2.1-3.7a4.5 4.5 0 0 0-3.6-2c-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9a4.9 4.9 0 0 0-4.1 2.5c-1.8 3-.5 7.6 1.3 10 .9 1.2 1.9 2.5 3.3 2.4 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8c1.4 0 2.3-1.2 3.1-2.4 1-1.4 1.4-2.8 1.4-2.9-.1 0-3.2-1.2-3.2-3.9ZM14.6 5.2a4.2 4.2 0 0 0 1-3 4.3 4.3 0 0 0-2.8 1.4 4 4 0 0 0-1 2.9 3.6 3.6 0 0 0 2.8-1.3Z" />
        </svg>
        <span>{t.hero.ctaAppStore}</span>
      </a>
      <a class="guide-store-button" href={PLAY_STORE_URL} rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M3.4 2.3c-.3.4-.5.9-.5 1.6v16.2c0 .6.2 1.1.5 1.5l9.1-9.6-9.1-9.7Zm10.2 10.8-2.3 2.4-6.6 6.9c.3.1.7 0 1.2-.2l11.3-6.4-3.6-2.7Zm4.9-1-3.8-2.2-1.1 1.1 1.1 1.1 3.8 2.8 1.9-1.1c.9-.5.9-1.2 0-1.7l-1.9-1Zm-13.8-10 6.6 6.9 2.3 2.4 3.6-2.7L5.9 1.9c-.5-.2-.9-.2-1.2.2Z" />
        </svg>
        <span>{t.hero.ctaPlay}</span>
      </a>
    </div>
    <p class="guide-app-disclaimer">{t.footer.disclaimer}</p>
  </div>
</section>
