---
import GuideArticle from '../../../components/GuideArticle.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/locales.js';
import { guidesForLocale } from '../../../i18n/guides.js';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of NON_DEFAULT_LOCALES) {
    const guides = await guidesForLocale(lang);
    for (const { entry, slug } of guides) {
      paths.push({ params: { lang, slug }, props: { entry, slug } });
    }
  }
  return paths;
}

const { lang } = Astro.params;
const { entry, slug } = Astro.props;
---

<GuideArticle locale={lang} entry={entry} slug={slug} />
