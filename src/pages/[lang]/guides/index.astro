---
import GuideDirectory from '../../../components/GuideDirectory.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/locales.js';
import { guidesForLocale } from '../../../i18n/guides.js';

export async function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const guides = await guidesForLocale(lang);
---

<GuideDirectory locale={lang} guides={guides} />
