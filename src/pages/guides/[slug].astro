---
import GuideArticle from '../../components/GuideArticle.astro';
import { guidesForLocale } from '../../i18n/guides.js';

export async function getStaticPaths() {
  const guides = await guidesForLocale('en');
  return guides.map(({ entry, slug }) => ({ params: { slug }, props: { entry, slug } }));
}

const { entry, slug } = Astro.props;
---

<GuideArticle locale="en" entry={entry} slug={slug} />
